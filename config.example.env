# Trusted root-owned Bash file. Values here override corresponding CLI options.
PANEL_VERSION=latest
AUTO_DOMAIN_SUFFIX=cdn-one.org
# Leave empty for two independent public IPv4 probes.
PUBLIC_IPV4=
ACME_EMAIL=
# Staging is only for debugging ACME; diagnostics deliberately reject untrusted certificates.
ACME_STAGING=no

# Optional own domains: set BOTH, or leave both empty for automatic domains.
# Distinct DNS names with A records pointing directly to PUBLIC_IPV4.
# No CDN proxy, AAAA or CNAME records in this IPv4-only adapter.
WEB_DOMAIN=
REALITY_DOMAIN=
# Example:
# WEB_DOMAIN=vpn.example.com
# REALITY_DOMAIN=reality.example.com
# Existing installations keep saved domains when these are empty.
# Changing either saved domain requires a separate migration, not a rerun.

# Optional IP SAN TLS on a FRESH VPS; empty preserves saved mode on reruns.
# IP_TLS=yes uses the public IPv4 and an automatic REALITY DNS name.
# Cannot be combined with WEB_DOMAIN/REALITY_DOMAIN.
IP_TLS=
